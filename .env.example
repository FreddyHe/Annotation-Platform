# Copy to .env.local; source with: set -a; source .env.local; set +a
# Supported deployment layout: /root/autodl-fs/Annotation-Platform
# Generate a private secret using: openssl rand -hex 48
APP_JWT_SECRET=replace-with-your-own-random-secret-at-least-48-bytes
LABEL_STUDIO_INTERNAL_URL=http://127.0.0.1:5001
LABEL_STUDIO_PUBLIC_URL=http://YOUR_SERVER:5001
LABEL_STUDIO_ENV_PATH=/root/.local/share/label-studio/.env
UPLOAD_BASE_PATH=/root/autodl-fs/uploads
ALGORITHM_UVICORN=/root/miniconda3/envs/annotation_algo/bin/uvicorn
LABEL_STUDIO_PROXY_PYTHON=/root/miniconda3/envs/web_annotation/bin/python
DINO_MODEL_PATH=/root/autodl-fs/GroundingDINO/weights/groundingdino_swint_ogc.pth
DINO_CONFIG_PATH=/root/autodl-fs/GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py
DINO_BERT_PATH=/root/autodl-fs/models/bert-base-uncased
QWEN_VLM_MODEL_PATH=/root/autodl-fs/models/Qwen3-VL-4B-Instruct
LOCAL_VLM_BASE_URL=http://127.0.0.1:5008/v1
LOCAL_VLM_MODEL_NAME=Qwen3-VL-4B-Instruct
LOCAL_VLM_CUDA_VISIBLE_DEVICES=0
LOCAL_VLM_GPU_MEMORY_UTILIZATION=0.40
LOCATE_ANYTHING_PYTHON=/root/miniconda3/envs/LLM_DL/bin/python
LOCATE_ANYTHING_CODE_ROOT=/root/autodl-fs/external/Eagle/Embodied
LOCATE_ANYTHING_MODEL_PATH=/root/autodl-fs/models/LocateAnything-3B
LOCATE_ANYTHING_CUDA_VISIBLE_DEVICES=0
# Optional cloud requirement parser; otherwise rule-based fallback is used.
CHATANYWHERE_API_KEY=
